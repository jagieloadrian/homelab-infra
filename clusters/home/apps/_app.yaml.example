apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: APP
  namespace: flux-system
spec:
  interval: 24h
  url: https://github.com/jagieloadrian/APP
  ref:
    branch: main
  ignore: |
    /*
    !/.devops/helm/
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: APP
  namespace: flux-system
spec:
  dependsOn:
    - name: infrastructure
  interval: 10m
  path: ./.devops/helm
  prune: true
  targetNamespace: apps
  sourceRef:
    kind: GitRepository
    name: APP
